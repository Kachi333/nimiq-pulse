# Copy to .env and fill in. Never commit .env.

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# mainalbatross | testalbatross
# The database is network-scoped (pulse.<network>.db), so switching never mixes
# testnet and mainnet payments. Each network needs its own `npm run seed`.
NIMIQ_NETWORK=testalbatross

# WHERE REAL NIM LANDS. Must be an address you control (Nimiq Pay → Receive).
# Left empty, the API withholds tip quests rather than sending payments to an
# address nobody owns.
TIP_JAR_ADDRESS=

MIN_REVIEW_LUNA=100000
CONFIRMATIONS=120
INDEX_INTERVAL_SEC=20
PORT=8787

# Explicit allowlist, never '*'. Must match the Network URL Vite prints,
# port included, or the phone loads the app but every API call fails.
CORS_ORIGINS=http://localhost:5173,http://192.168.1.46:5173
