# Copy to .env. Client config ONLY — Vite inlines VITE_* vars into the bundle,
# so never put a secret here. Both values below are public by nature.

# Leave unset to default to http://<current-host>:8787, which works on LAN.
# VITE_API_BASE=http://192.168.1.46:8787

# Where tip-jar quest payments go. Must match TIP_JAR_ADDRESS in pulse-api/.env.
VITE_TIP_JAR_ADDRESS=
